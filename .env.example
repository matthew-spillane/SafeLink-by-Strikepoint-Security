# PhishScan Environment Variables

# VirusTotal API Key (get one at https://www.virustotal.com/gui/join-us)
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Google Safe Browsing API Key (get one at https://console.cloud.google.com/apis/library/safebrowsing.googleapis.com)
GOOGLE_SAFE_BROWSING_API_KEY=your_google_safe_browsing_api_key_here

# Database URL (defaults to SQLite)
DATABASE_URL=sqlite:///./phishscan.db

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000
